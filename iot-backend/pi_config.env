# pi_config.env - Raspberry Pi Configuration for MEGG IoT Backend

# Arduino Configuration
ARDUINO_PORT=/dev/ttyUSB0
ARDUINO_BAUDRATE=9600
ARDUINO_TIMEOUT=1.0

# WebSocket Server Configuration
IOT_BACKEND_HOST=0.0.0.0
IOT_BACKEND_PORT=8765

# Raspberry Pi Specific Settings
PLATFORM=raspberry_pi
AUTO_DETECT_PORTS=true

# Optional: GPIO Settings (if using GPIO for additional sensors)
# ENABLE_GPIO=false
# GPIO_SENSOR_PINS=18,23,24

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/var/log/megg-iot-backend.log

# Performance Settings
MAX_CONNECTIONS=10
PING_INTERVAL=30
CONNECTION_TIMEOUT=60
